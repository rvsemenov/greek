{
  "rule": "B2/10-learned-prepositions",
  "title": "Λόγιες προθέσεις και σταθερές φράσεις",
  "level": "B2",
  "items": [
    {
      "id": "b2-10-0001",
      "type": "choice",
      "prompt": "Η πτήση ακυρώθηκε λόγω ___ κακοκαιρίας.",
      "options": ["της", "την", "τη", "τις"],
      "answer": "της",
      "why": "«Λόγω» требует родительного падежа: λόγω της κακοκαιρίας. Винительный (την, τη) здесь ошибочен, как и в русском «из-за погоды» (родительный).",
      "words": ["λόγω", "κακοκαιρία"],
      "tags": ["prepositions", "genitive"]
    },
    {
      "id": "b2-10-0002",
      "type": "cloze",
      "prompt": "Κατά ___ διάρκεια της συνάντησης δεν μίλησε κανείς.",
      "answer": "τη",
      "accept": ["τη"],
      "why": "«Κατά» + винительный значит «во время»: κατά τη διάρκεια. С родительным «κατά» означает «против», как в κατά του νόμου.",
      "words": ["κατά", "διάρκεια", "συνάντηση"],
      "tags": ["prepositions", "register"]
    },
    {
      "id": "b2-10-0003",
      "type": "choice",
      "prompt": "Το κτίριο είναι ___ κατασκευή.",
      "options": ["υπό", "σε", "για", "από"],
      "answer": "υπό",
      "why": "«Υπό» + винительный — «в процессе»: υπό κατασκευή (строится). «Σε», «για», «από» здесь не дают значения «в процессе».",
      "words": ["κτίριο", "κατασκευή"],
      "tags": ["prepositions", "register"]
    },
    {
      "id": "b2-10-0004",
      "type": "cloze",
      "prompt": "Εν ___ μεταξύ, ο Γιώργος είχε φύγει.",
      "answer": "τω",
      "accept": ["τω"],
      "why": "«Εν» требует древнего дательного: εν τω μεταξύ — «тем временем». Обычный артикль «το», «τη» или «τον» здесь не подходит.",
      "words": ["μεταξύ"],
      "tags": ["prepositions", "register"]
    },
    {
      "id": "b2-10-0005",
      "type": "choice",
      "prompt": "Σας ευχαριστώ ___ όλης της ομάδας.",
      "options": ["εκ μέρους", "σε μέρος", "μέσω μέρους", "κατά μέρος"],
      "answer": "εκ μέρους",
      "why": "«Εκ μέρους» + родительный — «от имени»: εκ μέρους όλης της ομάδας. Остальные сочетания дают другое значение («частично», «через»).",
      "words": ["μέρος", "ομάδα"],
      "tags": ["prepositions", "genitive"]
    },
    {
      "id": "b2-10-0006",
      "type": "choice",
      "prompt": "Η αίτηση υποβάλλεται ___ δέκα ημερών.",
      "options": ["εντός", "εκτός", "εξαιτίας", "βάσει"],
      "answer": "εντός",
      "why": "«Εντός» + родительный — «в пределах, в течение»: εντός δέκα ημερών. «Εκτός» — «вне», «εξαιτίας» — «из-за», «βάσει» — «на основании».",
      "words": ["εντός", "ημέρα"],
      "tags": ["prepositions", "genitive"]
    },
    {
      "id": "b2-10-0007",
      "type": "choice",
      "prompt": "Το ασανσέρ είναι ___ λειτουργίας.",
      "options": ["εκτός", "εντός", "μέσω", "λόγω"],
      "answer": "εκτός",
      "why": "«Εκτός λειτουργίας» — «не работает» (вне работы). «Εντός» означает «внутри, в пределах», а не «вне».",
      "words": ["εκτός", "λειτουργία", "ασανσέρ"],
      "tags": ["prepositions", "genitive"]
    },
    {
      "id": "b2-10-0008",
      "type": "choice",
      "prompt": "Χάρη ___ βοήθειά σου τα κατάφερα.",
      "options": ["στη", "της", "τη", "σε"],
      "answer": "στη",
      "why": "«Χάρη σε» + винительный — «благодаря»: χάρη στη βοήθειά σου. Родительный «χάρη της βοήθειας» означает «ради помощи», а не «благодаря».",
      "words": ["χάρη", "βοήθεια"],
      "tags": ["prepositions", "accusative"]
    },
    {
      "id": "b2-10-0009",
      "type": "choice",
      "prompt": "Είμαι ___ του νόμου.",
      "options": ["υπέρ", "κατά", "υπό", "μετά"],
      "answer": "υπέρ",
      "why": "«Υπέρ» + родительный — «за»: υπέρ του νόμου. «Κατά» + родительный значит «против», то есть противоположный смысл.",
      "words": ["υπέρ", "νόμος"],
      "tags": ["prepositions", "genitive"]
    },
    {
      "id": "b2-10-0010",
      "type": "choice",
      "prompt": "Κατά ___ γνώμη μου, έχει δίκιο.",
      "options": ["τη", "της", "την", "τον"],
      "answer": "τη",
      "why": "«Κατά» + винительный — «по мнению»: κατά τη γνώμη μου. С родительным «κατά της γνώμης μου» значило бы «против моего мнения».",
      "words": ["γνώμη"],
      "tags": ["prepositions", "accusative"]
    },
    {
      "id": "b2-10-0011",
      "type": "choice",
      "prompt": "Το ήξερα ___ αρχής.",
      "options": ["εξ", "εκ", "μετά", "διά"],
      "answer": "εξ",
      "why": "«Εξ αρχής» — «с самого начала». Перед гласной «εκ» превращается в «εξ», поэтому *εκ αρχής — ошибка.",
      "words": ["αρχή"],
      "tags": ["prepositions", "register"]
    },
    {
      "id": "b2-10-0012",
      "type": "choice",
      "prompt": "Δέχτηκε την πρόσκληση ___ χαράς.",
      "options": ["μετά", "άνευ", "διά", "μέσω"],
      "answer": "μετά",
      "why": "«Μετά» + родительный (книжн.) — «с» (чувство): μετά χαράς — «с радостью». «Άνευ» — «без», «διά» — «через», «μέσω» — «посредством».",
      "words": ["μετά", "πρόσκληση", "χαρά"],
      "tags": ["prepositions", "genitive", "register"]
    },
    {
      "id": "b2-10-0013",
      "type": "cloze",
      "prompt": "Τα εμπορεύματα έφτασαν ___ θαλάσσης.",
      "answer": "διά",
      "accept": ["διά"],
      "why": "«Διά» + родительный — «через, морем»: διά θαλάσσης. Здесь нужен именно этот предлог с родительным падежом.",
      "words": ["διά", "θάλασσα"],
      "tags": ["prepositions", "genitive"]
    },
    {
      "id": "b2-10-0014",
      "type": "choice",
      "prompt": "Αυτό μένει ___ μας.",
      "options": ["μεταξύ", "μέσω", "βάσει", "κατά"],
      "answer": "μεταξύ",
      "why": "«Μεταξύ μας» — «между нами» (конфиденциально). «Μέσω» — «через, посредством», «βάσει» — «на основании», «κατά» — «против».",
      "words": ["μεταξύ", "μένω"],
      "tags": ["prepositions", "register"]
    },
    {
      "id": "b2-10-0015",
      "type": "cloze",
      "prompt": "Η απόφαση είναι νόμιμη ___ του νόμου.",
      "answer": "βάσει",
      "accept": ["βάσει"],
      "why": "«Βάσει» + родительный — «на основании»: βάσει του νόμου. Здесь предлог указывает на основу решения.",
      "words": ["βάσει", "νόμος"],
      "tags": ["prepositions", "genitive"]
    },
    {
      "id": "b2-10-0016",
      "type": "cloze",
      "prompt": "Το είδα ___ ημερών στην τηλεόραση.",
      "answer": "προ",
      "accept": ["προ"],
      "why": "«Προ» + родительный — «несколько дней назад»: προ ημερών. Обычное «πριν» здесь не употребляется с родительным падежом.",
      "words": ["προ", "ημέρα"],
      "tags": ["prepositions", "genitive"]
    }
  ]
}
