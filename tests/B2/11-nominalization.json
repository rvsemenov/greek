{
  "rule": "B2/11-nominalization",
  "title": "Номинализация — το να…, το ότι…, το πώς…",
  "level": "B2",
  "items": [
    {
      "id": "b2-11-0001",
      "type": "choice",
      "prompt": "___ μαθαίνεις γλώσσες είναι χρήσιμο. (учить языки полезно)",
      "options": [
        "Το να",
        "Το ότι",
        "Το αν",
        "Το πώς"
      ],
      "answer": "Το να",
      "why": "Действие как явление (русский инфинитив): το να + глагол.",
      "words": [
        "μαθαίνω",
        "γλώσσα",
        "χρήσιμος"
      ],
      "tags": [
        "syntax",
        "subjunctive"
      ]
    },
    {
      "id": "b2-11-0002",
      "type": "choice",
      "prompt": "___ δεν ήρθε με στενοχώρησε. (то, что он не пришёл, меня расстроило)",
      "options": [
        "Το ότι",
        "Το αν",
        "Το να",
        "Το πώς"
      ],
      "answer": "Το ότι",
      "why": "Факт, «то, что…»: το ότι + изъявительное.",
      "words": [
        "στενοχωρώ",
        "έρχομαι"
      ],
      "tags": [
        "syntax",
        "conjunctions"
      ]
    },
    {
      "id": "b2-11-0003",
      "type": "choice",
      "prompt": "___ θα έρθει δεν το ξέρω. (придёт ли он, я не знаю)",
      "options": [
        "Το αν",
        "Το ότι",
        "Το να",
        "Το πού"
      ],
      "answer": "Το αν",
      "why": "«Ли» — το αν + глагол: вопрос о том, произойдёт ли.",
      "words": [
        "έρχομαι",
        "ξέρω"
      ],
      "tags": [
        "syntax",
        "conjunctions"
      ]
    },
    {
      "id": "b2-11-0004",
      "type": "choice",
      "prompt": "___ το έκανε είναι μυστήριο. (как он это сделал — загадка)",
      "options": [
        "Το πώς",
        "Το ότι",
        "Το αν",
        "Το να"
      ],
      "answer": "Το πώς",
      "why": "Косвенный вопрос «как» как предмет: το πώς + глагол.",
      "words": [
        "κάνω",
        "μυστήριο"
      ],
      "tags": [
        "syntax",
        "questions"
      ]
    },
    {
      "id": "b2-11-0005",
      "type": "cloze",
      "prompt": "Ζήτησε συγγνώμη για ___ άργησε. (он извинился за то, что опоздал)",
      "answer": "το ότι",
      "accept": [
        "το ότι"
      ],
      "why": "После предлога — через артикль: για το ότι.",
      "words": [
        "συγγνώμη",
        "αργώ"
      ],
      "tags": [
        "syntax",
        "prepositions"
      ]
    },
    {
      "id": "b2-11-0006",
      "type": "cloze",
      "prompt": "___ καπνίζεις βλάπτει. (курить вредно)",
      "answer": "Το να",
      "accept": [
        "Το να"
      ],
      "why": "Действие как подлежащее: Το να καπνίζεις βλάπτει.",
      "words": [
        "καπνίζω",
        "βλάπτω"
      ],
      "tags": [
        "syntax",
        "subjunctive"
      ]
    },
    {
      "id": "b2-11-0007",
      "type": "choice",
      "prompt": "Δεν με ενδιαφέρει ___ θα πουν οι άλλοι. (мне неважно, что скажут другие)",
      "options": [
        "τι",
        "πώς",
        "αν",
        "το ότι"
      ],
      "answer": "τι",
      "why": "Вопросительное «что» в косвенной речи после ενδιαφέρει: τι θα πουν.",
      "words": [
        "ενδιαφέρω",
        "λέω"
      ],
      "tags": [
        "syntax",
        "questions"
      ]
    },
    {
      "id": "b2-11-0008",
      "type": "choice",
      "prompt": "Με ___ να φωνάζεις δεν λύνεται τίποτα. (криком ничего не решить)",
      "options": [
        "το",
        "τα",
        "την",
        "ότι"
      ],
      "answer": "το",
      "why": "Предлог με + артикль + конструкция с να: με το να φωνάζεις.",
      "words": [
        "φωνάζω",
        "λύνω"
      ],
      "tags": [
        "syntax",
        "prepositions"
      ]
    },
    {
      "id": "b2-11-0009",
      "type": "choice",
      "prompt": "Βλάπτει ___ καπνίζεις. (курить вредно — без артикля)",
      "options": [
        "να",
        "το να",
        "το ότι",
        "για να"
      ],
      "answer": "να",
      "why": "Главная часть без артикля: βλάπτει να καπνίζεις; артикль нужен только в начале предложения.",
      "words": [
        "βλάπτω",
        "καπνίζω"
      ],
      "tags": [
        "syntax",
        "subjunctive"
      ]
    },
    {
