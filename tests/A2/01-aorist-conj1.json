      "accept": ["έκοψε"],
      "why": "κόβω → έκοψε: -βω → -ψ-, приращение έ- ставится из-за двух слогов.",
      "words": ["κόβω", "ψωμί", "χθες"],
      "tags": ["aorist", "verbs"]
    },
    {
      "id": "a2-01-0015",
      "type": "inflect",
      "prompt": "ψάχνω → αόριστος, 1-е лицо ед. ч.",
      "answer": "έψαξα",
      "accept": ["έψαξα"],
      "why": "-χνω → -ξα: ψάχνω → έψαξα. Приращение έ- ставится, потому что слов два слога.",
      "words": ["ψάχνω"],
      "tags": ["aorist"]
    },
    {
      "id": "a2-01-0016",
      "type": "choice",
      "prompt": "Χθες ___ μπάλα με τον φίλο μου.",
      "options": ["παίζω", "έπαιξα", "θα παίξω", "έπαιζα"],
      "answer": "έπαιξα",
      "why": "«Χθες» + однократное действие → аорист έπαιξα. «έπαιζα» — процесс «играл» без границы.",
      "words": ["παίζω", "μπάλα", "χθες"],
      "tags": ["aorist", "past"]
    },
    {
      "id": "a2-01-0017",
      "type": "cloze",
      "prompt": "Εσείς ___ την πόρτα; (κλείνω, 2-е лицо мн. ч.)",
      "answer": "κλείσατε",
      "accept": ["κλείσατε"],
      "why": "2-е лицо мн. ч. аориста: -σατε без приращения; ударение на 3-м слоге от конца — κλείσατε.",
      "words": ["κλείνω", "πόρτα"],
      "tags": ["aorist", "stress"]
    },
    {
      "id": "a2-01-0018",
      "type": "inflect",
      "prompt": "ανοίγω → αόριστος, 2-е лицо мн. ч. (εσείς)",
      "answer": "ανοίξατε",
      "accept": ["ανοίξατε"],
      "why": "Как и κλείσατε: -ξατε без приращения, ударение на ί — ανοίξατε.",
      "words": ["ανοίγω"],
      "tags": ["aorist", "stress"]
    },
    {
      "id": "a2-01-0019",
      "type": "choice",
      "prompt": "Χθες ___ από το μάθημα.",
      "options": ["λείπω", "έλειψα", "θα λείψω", "έλειπα"],
      "answer": "έλειψα",
      "why": "«Χθες» + однократный пропуск → аорист. «έλειπα» — длящееся состояние «меня не было».",
      "words": ["λείπω", "μάθημα", "χθες"],
      "tags": ["aorist", "past"]
    },
    {
      "id": "a2-01-0020",
      "type": "inflect",
