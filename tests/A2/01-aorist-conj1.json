{
  "rule": "A2/01-aorist-conj1",
  "title": "Αόριστος 1-го спряжения",
  "level": "A2",
  "items": [
    {
      "id": "a2-01-0001",
      "type": "choice",
      "prompt": "Χθες ___ ένα γράμμα.",
      "options": ["γράφω", "έγραψα", "θα γράψω", "έγραφα"],
      "answer": "έγραψα",
      "why": "«Χθες» + одно законченное действие → аорист. «έγραφα» — παρατατικός, «писал» как процесс, без результата.",
      "words": ["γράφω", "γράμμα", "χθες"],
      "tags": ["aorist", "past"]
    },
    {
      "id": "a2-01-0002",
      "type": "choice",
      "prompt": "Εσύ ___ το μάθημα νωρίς;",
      "options": ["τελειώνεις", "τελείωσες", "θα τελειώσεις", "τελείωνες"],
      "answer": "τελείωσες",
      "why": "Вопрос о законченном действии в прошлом → аорист, 2-е лицо ед. ч. — -ες.",
      "words": ["τελειώνω", "μάθημα"],
      "tags": ["aorist", "verbs"]
    },
    {
      "id": "a2-01-0003",
      "type": "inflect",
      "prompt": "γράφω → αόριστος, 1-е лицо мн. ч. (εμείς)",
      "answer": "γράψαμε",
      "accept": ["γράψαμε"],
      "why": "В формах на -αμε приращение не ставится, слогов хватает: γράψαμε, а не εγράψαμε.",
      "words": ["γράφω"],
      "tags": ["aorist", "stress"]
    },
    {
      "id": "a2-01-0004",
      "type": "choice",
      "prompt": "Ο αέρας ___ την πόρτα.",
      "options": ["άνοιξε", "ανοίγει", "θα ανοίξει", "άνοιγε"],
      "answer": "άνοιξε",
      "why": "Однократное действие в прошлом → аорист. Глагол на гласную (ανοίγω) приращения не получает: άνοιξε, а не έανοιξε.",
      "words": ["ανοίγω", "πόρτα"],
      "tags": ["aorist", "verbs"]
    },
    {
      "id": "a2-01-0005",
      "type": "choice",
      "prompt": "Ποιος ___ την πόρτα;",
      "options": ["κλείνει", "έκλεισε", "θα κλείσει", "έκλεινε"],
      "answer": "έκλεισε",
      "why": "«Ποιος» + однократное действие → аорист. От κλείνω аорист — έκλεισε: «ν» в аористе выпадает.",
      "words": ["κλείνω", "πόρτα"],
      "tags": ["aorist", "questions"]
    },
    {
      "id": "a2-01-0006",
      "type": "inflect",
      "prompt": "κόβω → αόριστος, 1-е лицо ед. ч.",
      "answer": "έκοψα",
      "accept": ["έκοψα"],
      "why": "-βω → -ψα; κόβω — два слога, поэтому ставится приращение έ-.",
      "words": ["κόβω"],
      "tags": ["aorist", "verbs"]
    },
    {
      "id": "a2-01-0007",
      "type": "choice",
      "prompt": "Τα παιδιά ___ στον κήπο.",
      "options": ["παίζουν", "έπαιξαν", "θα παίξουν", "έπαιζαν"],
      "answer": "έπαιξαν",
      "why": "Одно законченное действие → аорист. От παίζω аорист с -ξ- (έπαιξαν), это исключение из -ζω → -σα. «έπαιζαν» — процесс «играли».",
      "words": ["παίζω", "κήπος"],
      "tags": ["aorist", "verbs"]
    },
    {
      "id": "a2-01-0008",
      "type": "choice",
      "prompt": "Οι φίλοι μου ___ τον λογαριασμό.",
      "options": ["πληρώνουν", "πλήρωσαν", "θα πληρώσουν", "πλήρωναν"],
      "answer": "πλήρωσαν",
      "why": "Оплата — одно законченное действие → аорист. «πλήρωναν» — παρατατικός, «платили» как процесс.",
      "words": ["πληρώνω"],
      "tags": ["aorist", "past"]
    },
    {
      "id": "a2-01-0009",
      "type": "choice",
      "prompt": "Αυτός ___ στη δουλειά χθες.",
      "options": ["δουλεύει", "δούλεψε", "θα δουλέψει", "δούλευε"],
      "answer": "δούλεψε",
      "why": "«Χθες» → аорист. От -εύω аорист на -εψ-: δούλεψε, а не δούλευσε.",
      "words": ["δουλεύω", "χθες"],
      "tags": ["aorist", "verbs"]
    },
    {
      "id": "a2-01-0010",
      "type": "inflect",
      "prompt": "τελειώνω → αόριστος, 1-е лицо ед. ч.",
      "answer": "τελείωσα",
      "accept": ["τελείωσα"],
      "why": "Длинный глагол: приращения нет, ударение на 3-м слоге от конца — τελείωσα, не έτελειωσα.",
      "words": ["τελειώνω"],
      "tags": ["aorist", "stress"]
    },
    {
      "id": "a2-01-0011",
      "type": "choice",
      "prompt": "Το μάθημα ___ στις οκτώ.",
      "options": ["τελειώνει", "τελείωσε", "θα τελειώσει", "τελείωνε"],
      "answer": "τελείωσε",
      "why": "«Στις οκτώ» — конкретный момент завершения → аорист. «τελείωνε» — процесс «шёл к концу» (παρατατικός).",
      "words": ["τελειώνω", "μάθημα"],
      "tags": ["aorist", "past"]
    },
    {
      "id": "a2-01-0012",
      "type": "choice",
      "prompt": "Εμείς ___ μέχρι το πρωί.",
      "options": ["χορεύαμε", "χορέψαμε", "θα χορέψουμε", "χορεύουμε"],
      "answer": "χορέψαμε",
      "why": "«Μέχρι το πρωί» — действие с границей, законченное → аорист. «χορεύαμε» — длящийся процесс без границы.",
      "words": ["χορεύω", "πρωί"],
      "tags": ["aorist", "verbs"]
    },
    {
      "id": "a2-01-0013",
      "type": "inflect",
      "prompt": "δουλεύω → αόριστος, 1-е лицо ед. ч.",
      "answer": "δούλεψα",
      "accept": ["δούλεψα"],
      "why": "-εύω → -εψ-: δούλεψα, а не δούλευσα.",
      "words": ["δουλεύω"],
      "tags": ["aorist", "verbs"]
    },
    {
      "id": "a2-01-0014",
      "type": "cloze",
      "prompt": "Χθες ___ το ψωμί. (κόβω, 3-е лицо ед. ч.)",
