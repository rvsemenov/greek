{
  "rule": "A2/15-conjunctions-basic",
  "title": "Союзы — και, αλλά, ή, γιατί/επειδή, όταν, αν, ότι, που",
  "level": "A2",
  "items": [
    {
      "id": "a2-15-0001",
      "type": "choice",
      "prompt": "Θέλεις τσάι ___ καφέ; (чай или кофе?)",
      "options": [
        "ή",
        "η",
        "και",
        "αλλά"
      ],
      "answer": "ή",
      "why": "«Или» — союз ή (с ударением). «η» — артикль женского рода, здесь не подходит.",
      "words": [
        "τσάι",
        "καφές"
      ],
      "tags": [
        "conjunctions"
      ]
    },
    {
      "id": "a2-15-0002",
      "type": "choice",
      "prompt": "Θέλω, ___ δεν μπορώ. (хочу, но не могу)",
      "options": [
        "αλλά",
        "και",
        "ή",
        "γιατί"
      ],
      "answer": "αλλά",
      "why": "Противопоставление «но» — αλλά.",
      "words": [
        "θέλω",
        "μπορώ"
      ],
      "tags": [
        "conjunctions"
      ]
    },
    {
      "id": "a2-15-0003",
      "type": "choice",
      "prompt": "Δεν πήγα στη δουλειά, ___ ήμουν άρρωστη. (я не пошла на работу, потому что болела)",
      "options": [
        "γιατί",
        "πού",
        "πώς",
        "ότι"
      ],
      "answer": "γιατί",
      "why": "«Потому что» — γιατί (или επειδή); «πού» — «где?», «πώς» — «как?».",
      "words": [
        "δουλειά",
        "άρρωστος"
      ],
      "tags": [
        "conjunctions"
      ]
    },
    {
      "id": "a2-15-0004",
      "type": "choice",
      "prompt": "___ βρέχει, θα μείνουμε σπίτι. (так как идёт дождь, мы останемся дома)",
      "options": [
        "Επειδή",
        "Όταν",
        "Αν",
        "Ότι"
      ],
      "answer": "Επειδή",
      "why": "«Так как» — επειδή (причина, факт). «Όταν» — «когда», «αν» — «если».",
      "words": [
        "βρέχω",
        "σπίτι"
      ],
      "tags": [
        "conjunctions"
      ]
    },
    {
      "id": "a2-15-0005",
      "type": "choice",
      "prompt": "___ τελειώσω, θα σου τηλεφωνήσω. (когда закончу, позвоню тебе)",
      "options": [
        "Όταν",
        "Αν",
        "Ενώ",
        "Ότι"
      ],
      "answer": "Όταν",
      "why": "«Когда» о будущем: όταν + форма без θα (τελειώσω).",
      "words": [
        "τελειώνω",
        "τηλεφωνώ"
      ],
      "tags": [
        "conjunctions",
        "future"
      ]
    },
    {
      "id": "a2-15-0006",
      "type": "choice",
      "prompt": "___ έχεις χρόνο, έλα το βράδυ. (если у тебя есть время, приходи вечером)",
      "options": [
        "Αν",
        "Όταν",
        "Επειδή",
        "Ενώ"
      ],
      "answer": "Αν",
      "why": "«Если» — αν; после него настоящее без θα.",
      "words": [
        "έχω",
        "χρόνος"
      ],
      "tags": [
        "conjunctions",
        "conditionals"
      ]
    },
    {
      "id": "a2-15-0007",
      "type": "choice",
      "prompt": "Νομίζω ___ έχεις δίκιο. (думаю, что ты прав)",
      "options": [
        "ότι",
        "που",
        "γιατί",
        "αν"
      ],
      "answer": "ότι",
      "why": "После «думаю, знаю» — ότι («что»).",
      "words": [
        "νομίζω",
        "δίκιο"
      ],
      "tags": [
        "conjunctions",
        "syntax"
      ]
    },
    {
      "id": "a2-15-0008",
      "type": "choice",
      "prompt": "Αυτή είναι η γυναίκα ___ μένει δίπλα μας. (это женщина, которая живёт рядом с нами)",
      "options": [
        "που",
        "πού",
        "πως",
        "ότι"
      ],
      "answer": "που",
      "why": "«Который, который» — неизменяемое που (без ударения). «πού» — вопрос «где?».",
      "words": [
        "γυναίκα",
        "μένω"
      ],
      "tags": [
        "conjunctions",
        "pronouns"
      ]
    },
    {
      "id": "a2-15-0009",
      "type": "choice",
      "prompt": "Χαίρομαι ___ σε βλέπω. (рад тебя видеть)",
      "options": [
        "που",
        "πού",
        "πως",
        "ότι"
      ],
      "answer": "που",
      "why": "После «рад», «доволен» — που: Χαίρομαι που σε βλέπω.",
      "words": [
        "χαίρομαι",
        "βλέπω"
      ],
      "tags": [
        "conjunctions",
        "syntax"
      ]
    },
    {
      "id": "a2-15-0010",
      "type": "cloze",
      "prompt": "Δεν θέλω ___ τσάι ούτε καφέ. (ни чай, ни кофе — ни…ни)",
      "answer": "ούτε",
      "accept": [
        "ούτε"
      ],
      "why": "«Ни … ни» — ούτε … ούτε (с δεν).",
      "words": [
        "θέλω",
        "τσάι",
        "καφές"
      ],
      "tags": [
        "conjunctions",
        "negation"
      ]
    },
    {
      "id": "a2-15-0011",
      "type": "choice",
      "prompt": "Ήμουν κουρασμένος, ___ έμεινα σπίτι. (я устал, поэтому остался дома)",
      "options": [
        "γι' αυτό",
        "αλλά",
        "ή",
        "αν"
      ],
      "answer": "γι' αυτό",
      "why": "«Поэтому» — γι' αυτό: следствие, а не противопоставление.",
      "words": [
        "κουρασμένος",
        "σπίτι"
      ],
      "tags": [
        "conjunctions"
      ]
    },
    {
      "id": "a2-15-0012",
      "type": "choice",
      "prompt": "___ θέλεις να φύγεις; (почему ты хочешь уйти?)",
      "options": [
        "Γιατί",
        "Πού",
        "Πώς",
        "Ότι"
      ],
      "answer": "Γιατί",
      "why": "γιατί в вопросе — «почему?».",
      "words": [
        "φεύγω",
        "θέλω"
      ],
      "tags": [
        "conjunctions",
        "questions"
      ]
    },
    {
      "id": "a2-15-0013",
      "type": "choice",
      "prompt": "Δεν ξέρω ___ είναι τα κλειδιά. (не знаю, где ключи)",
      "options": [
        "πού",
        "που",
        "πώς",
        "ότι"
      ],
      "answer": "πού",
      "why": "Косвенный вопрос с «где»: πού (с ударением), а не союз που.",
      "words": [
        "ξέρω",
        "κλειδί"
      ],
      "tags": [
        "conjunctions",
        "questions"
      ]
    }
  ]
}
