{
  "rule": "A2/03-aorist-conj2",
  "title": "Αόριστος 2-го спряжения — -ησα, -ασα, -εσα, -ηξα",
  "level": "A2",
  "items": [
    {
      "id": "a2-03-0001",
      "type": "choice",
      "prompt": "Ποιος σου ___ ; (кто тебе звонил?)",
      "options": [
        "τηλεφώνησε",
        "τηλεφωνεί",
        "θα τηλεφωνήσει",
        "τηλεφωνούσε"
      ],
      "answer": "τηλεφώνησε",
      "why": "τηλεφωνώ (группа на -ώ) → суффикс -ησα: τηλεφώνησε. Одно законченное действие — аорист.",
      "words": [
        "τηλεφωνώ"
      ],
      "tags": [
        "aorist",
        "verbs"
      ]
    },
    {
      "id": "a2-03-0002",
      "type": "inflect",
      "prompt": "μιλάω (говорить) → αόριστος, 1-е лицо ед. ч. (я поговорил)",
      "answer": "μίλησα",
      "accept": [
        "μίλησα"
      ],
      "why": "Группа -άω: основа + -ησα, как у большинства глаголов: μιλάω → μίλησα.",
      "words": [
        "μιλάω"
      ],
      "tags": [
        "aorist",
        "verbs"
      ]
    },
    {
