{
  "rule": "B1/14-modality-as-makari",
  "title": "Модальность — ας, μακάρι να, να; μπορεί να, πρέπει να",
  "level": "B1",
  "items": [
    {
      "id": "b1-14-0001",
      "type": "choice",
      "prompt": "___ πάμε για καφέ απόψε!",
      "options": ["Ας", "Μακάρι", "Μπορεί", "Πρέπει"],
      "answer": "Ας",
      "why": "«Давай»: ας + 1-е лицо мн. ч. (πάμε), без να.",
      "words": ["πηγαίνω", "καφές"],
      "tags": ["modality", "subjunctive"]
    },
    {
      "id": "b1-14-0002",
      "type": "choice",
      "prompt": "___ περιμένει λίγο.",
      "options": ["Ας", "Μακάρι", "Μπορεί", "Πρέπει"],
      "answer": "Ας",
      "why": "«Пусть»: ας + 3-е лицо (περιμένει).",
      "words": ["περιμένω"],
      "tags": ["modality", "subjunctive"]
    },
    {
      "id": "b1-14-0003",
      "type": "choice",
      "prompt": "___ κερδίσουμε!",
      "options": ["Μακάρι να", "Μπορεί να", "Πρέπει να", "Ας"],
      "answer": "Μακάρι να",
      "why": "«Хоть бы»: μακάρι να + форма с να — пожелание, которое может сбыться.",
      "words": ["κερδίζω"],
      "tags": ["modality", "subjunctive"]
    },
    {
      "id": "b1-14-0004",
      "type": "choice",
      "prompt": "Μπορεί ___ βρέξει αύριο.",
      "options": ["να", "θα", "ας", "μακάρι"],
      "answer": "να",
      "why": "«Может быть»: μπορεί να + форма с να (βρέξει). Μπορεί не спрягается.",
      "words": ["βρέχω"],
      "tags": ["modality", "subjunctive"]
    },
    {
      "id": "b1-14-0005",
      "type": "choice",
      "prompt": "Πρέπει ___ κουρασμένη, δούλεψε όλη μέρα.",
      "options": ["να είναι", "είναι", "να είμαι", "είμαι"],
      "answer": "να είναι",
      "why": "«Должно быть»: πρέπει να + 3-е лицо (είναι) — вывод о вероятном, а не обязанность.",
      "words": ["είμαι", "μέρα"],
      "tags": ["modality", "subjunctive"]
    },
    {
      "id": "b1-14-0006",
      "type": "choice",
      "prompt": "___ ανοίξω το παράθυρο;",
      "options": ["Να", "Ας", "Μακάρι να", "Μπορεί να"],
      "answer": "Να",
      "why": "«Открыть окно?» — предложение услуги: να + 1-е лицо ед. ч. (ανοίξω) в вопросе.",
      "words": ["ανοίγω", "παράθυρο"],
      "tags": ["modality", "subjunctive"]
    },
    {
      "id": "b1-14-0007",
      "type": "choice",
      "prompt": "Έπρεπε ___ μου το πεις.",
      "options": ["να", "θα", "ας", "μακάρι"],
      "answer": "να",
      "why": "«Надо было»: έπρεπε να + форма с να — упрёк о прошлом.",
      "words": ["λέω"],
      "tags": ["modality", "subjunctive", "past"]
    },
    {
      "id": "b1-14-0008",
      "type": "choice",
      "prompt": "___ αργήσω λίγο.",
      "options": ["Μπορεί να", "Μπορώ να", "Πρέπει να", "Ας"],
      "answer": "Μπορεί να",
      "why": "«Может быть, опоздаю»: μπορεί να (безличное, вероятность). «Μπορώ να» — «я могу», личное.",
      "words": ["αργώ", "μπορώ"],
      "tags": ["modality", "subjunctive"]
    },
    {
      "id": "b1-14-0009",
      "type": "choice",
      "prompt": "Μακάρι να ___ στη θάλασσα.",
      "options": ["ήμουν", "είμαι", "θα ήμουν", "ήμαστε"],
      "answer": "ήμουν",
      "why": "«Вот бы быть» (сейчас нереально): μακάρι να + имперфект (ήμουν). Θα после μακάρι не ставится.",
      "words": ["είμαι", "θάλασσα"],
      "tags": ["modality", "past"]
    },
    {
      "id": "b1-14-0010",
      "type": "cloze",
      "prompt": "Θα ___ στο σπίτι τώρα.",
      "answer": "είναι",
      "accept": ["είναι"],
      "why": "«Наверное, дома»: θα + настоящее — догадка о настоящем: θα είναι.",
      "words": ["είμαι", "σπίτι"],
      "tags": ["modality", "future"]
    },
    {
