{
  "rule": "B1/11-time-purpose-clauses",
  "title": "Придаточные времени и цели — πριν, αφού, μόλις, ενώ, μέχρι να, για να",
  "level": "B1",
  "items": [
    {
      "id": "b1-11-0001",
      "type": "choice",
      "prompt": "___ βγεις, πάρε ομπρέλα.",
      "options": [
        "Πριν",
        "Αφού",
        "Μόλις",
        "Ενώ"
      ],
      "answer": "Πριν",
      "why": "«Перед тем как»: πριν + форма с να (βγεις), всегда — даже о прошлом и будущем.",
      "words": [
        "βγαίνω",
        "ομπρέλα"
      ],
      "tags": [
        "conjunctions",
        "subjunctive"
      ]
    },
    {
      "id": "b1-11-0002",
      "type": "choice",
      "prompt": "___ έφαγε, ξάπλωσε λίγο.",
      "options": [
        "Αφού",
        "Πριν",
        "Ώσπου να",
        "Για να"
      ],
      "answer": "Αφού",
      "why": "«После того как» о прошлом: αφού + изъявительное (έφαγε).",
      "words": [
        "τρώω",
        "ξαπλώνω"
      ],
      "tags": [
        "conjunctions",
        "past"
      ]
    },
    {
      "id": "b1-11-0003",
      "type": "choice",
      "prompt": "___ τελειώσω, θα σου τηλεφωνήσω.",
      "options": [
        "Μόλις",
        "Ενώ",
        "Μέχρι να",
        "Για να"
      ],
      "answer": "Μόλις",
      "why": "«Как только» о будущем: μόλις + форма с να (τελειώσω). «Ενώ» значит «пока», здесь не подходит.",
      "words": [
        "τελειώνω",
        "τηλεφωνώ"
      ],
      "tags": [
        "conjunctions",
        "subjunctive"
      ]
    },
    {
      "id": "b1-11-0004",
      "type": "choice",
      "prompt": "Ενώ ___ , χτύπησε το κουδούνι.",
      "options": [
        "διάβαζα",
        "διαβάσω",
        "διάβασα",
        "θα διαβάσω"
      ],
      "answer": "διάβαζα",
      "why": "«Пока»: ενώ — длящееся действие → имперфект (διάβαζα). Аорист описал бы одно законченное событие.",
      "words": [
        "διαβάζω",
        "κουδούνι"
      ],
      "tags": [
        "conjunctions",
        "imperfect"
      ]
    },
    {
      "id": "b1-11-0005",
      "type": "cloze",
      "prompt": "Θα μείνω εδώ μέχρι ___ σταματήσει η βροχή. (я останусь здесь, пока не кончится дождь)",
      "answer": "να",
      "accept": [
        "να"
      ],
      "why": "«Пока не»: μέχρι να + форма с να, без отрицания.",
      "words": [
        "βροχή",
        "μένω"
      ],
      "tags": [
        "conjunctions",
        "subjunctive"
      ]
    },
    {
      "id": "b1-11-0006",
      "type": "choice",
      "prompt": "Ήρθα στην Ελλάδα ___ μάθω ελληνικά.",
      "options": [
        "για να",
        "πριν",
        "αφού",
        "ενώ"
      ],
      "answer": "για να",
      "why": "«Чтобы»: για να + глагол (μάθω) — инфинитива в греческом нет.",
      "words": [
        "μαθαίνω",
        "ελληνικά"
      ],
      "tags": [
        "conjunctions",
        "subjunctive"
      ]
    },
    {
      "id": "b1-11-0007",
      "type": "choice",
      "prompt": "Από ___ που μετακόμισα, κοιμάμαι καλύτερα.",
      "options": [
        "τότε",
        "πριν",
        "μέχρι",
        "για"
      ],
      "answer": "τότε",
      "why": "«С тех пор как»: από τότε που + изъявительное.",
      "words": [
        "μετακομίζω",
        "κοιμάμαι"
      ],
      "tags": [
        "conjunctions",
        "past"
      ]
    },
    {
      "id": "b1-11-0008",
      "type": "choice",
      "prompt": "Πριν ___ , μου έδωσε τα κλειδιά.",
      "options": [
        "φύγει",
        "έφυγε",
        "φεύγει",
        "θα φύγει"
      ],
      "answer": "φύγει",
      "why": "После πριν всегда форма с να аориста, даже о прошлом: πριν φύγει.",
      "words": [
        "φεύγω",
        "κλειδί"
      ],
      "tags": [
        "conjunctions",
        "subjunctive"
      ]
    },
    {
      "id": "b1-11-0009",
      "type": "inflect",
      "prompt": "Πριν ___ (πηγαίνω, 1-е лицо ед. ч.) στη δουλειά, πίνω καφέ.",
      "answer": "πάω",
      "accept": [
        "πάω"
      ],
      "why": "После πριν — форма с να: να πάω (1-е л. ед. ч.).",
      "words": [
        "πηγαίνω",
        "δουλειά",
        "καφές"
      ],
      "tags": [
        "conjunctions",
        "subjunctive"
      ]
    },
    {
      "id": "b1-11-0010",
      "type": "choice",
      "prompt": "___ δεν θέλεις, δεν πάμε.",
      "options": [
        "Αφού",
        "Πριν",
        "Μόλις",
        "Μέχρι να"
      ],
      "answer": "Αφού",
      "why": "Здесь αφού значит «раз», «поскольку» — другое значение того же союза, не «после того как».",
      "words": [
        "θέλω",
        "πηγαίνω"
      ],
      "tags": [
        "conjunctions"
      ]
    },
    {
      "id": "b1-11-0011",
      "type": "choice",
      "prompt": "Ήρθα για ___ σε δω.",
      "options": [
        "να",
        "μην",
        "ότι",
        "πριν"
      ],
      "answer": "να",
      "why": "Цель: για να + форма с να (δω).",
      "words": [
        "βλέπω"
      ],
      "tags": [
        "conjunctions",
        "subjunctive"
      ]
    },
    {
      "id": "b1-11-0012",
      "type": "choice",
      "prompt": "Μίλα δυνατά, ___ σε ακούνε όλοι.",
      "options": [
        "ώστε να",
        "ενώ",
        "πριν",
        "αφού"
      ],
      "answer": "ώστε να",
      "why": "«Так, чтобы»: ώστε να + форма с να (ακούνε).",
      "words": [
        "μιλάω",
        "ακούω"
      ],
      "tags": [
        "conjunctions",
        "subjunctive"
      ]
    }
  ]
}
