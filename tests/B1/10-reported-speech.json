{
  "rule": "B1/10-reported-speech",
  "title": "Πλάγιος λόγος — косвенная речь: ότι/πως, αν, να",
  "level": "B1",
  "items": [
    {
      "id": "b1-10-0001",
      "type": "choice",
      "prompt": "Είπε ότι ___ κουρασμένος.",
      "options": [
        "είναι",
        "είμαι",
        "είστε",
        "είσαι"
      ],
      "answer": "είναι",
      "why": "В косвенной речи ότι + изъявительное; 3-е лицо ед. ч. — είναι.",
      "words": [
        "είμαι",
        "κουρασμένος"
      ],
      "tags": [
        "syntax",
        "conjunctions"
      ]
    },
    {
      "id": "b1-10-0002",
      "type": "choice",
      "prompt": "Με ρώτησε ___ θέλω καφέ.",
      "options": [
        "αν",
        "ότι",
        "πού",
        "να"
      ],
      "answer": "αν",
      "why": "Вопрос «да/нет» в косвенной речи вводится через αν («ли»).",
      "words": [
        "ρωτάω",
        "καφές"
      ],
      "tags": [
        "syntax",
        "conjunctions"
      ]
    },
    {
      "id": "b1-10-0003",
      "type": "choice",
      "prompt": "Με ρώτησε ___ μένω.",
      "options": [
        "πού",
        "αν",
        "ότι",
        "να"
      ],
      "answer": "πού",
      "why": "Вопросительное слово сохраняется: πού («где»). Здесь нужен не союз αν, а само вопросительное слово.",
      "words": [
        "ρωτάω",
        "μένω"
      ],
      "tags": [
        "syntax",
        "conjunctions"
      ]
    },
    {
      "id": "b1-10-0004",
      "type": "choice",
      "prompt": "Μου είπε ___ περιμένω.",
      "options": [
        "να",
        "ότι",
        "αν",
        "πού"
      ],
      "answer": "να",
      "why": "Просьба или приказ в косвенной речи вводится через να: повелительное превращается в форму с να.",
      "words": [
        "λέω",
        "περιμένω"
      ],
      "tags": [
        "subjunctive",
        "syntax"
      ]
    },
    {
      "id": "b1-10-0005",
      "type": "choice",
      "prompt": "Μου είπε ___ ανησυχώ.",
      "options": [
        "να μην",
        "να δεν",
        "μην",
        "δεν"
      ],
      "answer": "να μην",
      "why": "Запрет в косвенной речи: να μην + глагол (μην, а не δεν).",
      "words": [
        "ανησυχώ",
        "λέω"
      ],
      "tags": [
        "subjunctive",
        "negation"
      ]
    },
    {
      "id": "b1-10-0006",
      "type": "cloze",
      "prompt": "«Περίμενε εδώ!» (подожди здесь!) → Μου είπε ___ εδώ.",
      "answer": "να περιμένω",
      "accept": [
        "να περιμένω"
      ],
      "why": "Повелительное превращается в форму с να с новым лицом: να περιμένω («чтобы я подождал»).",
      "words": [
        "περιμένω"
      ],
      "tags": [
        "subjunctive",
        "syntax"
      ]
    },
    {
      "id": "b1-10-0007",
      "type": "cloze",
      "prompt": "«Θα έρθω στις οκτώ.» (приду в восемь) → Μου είπε ότι ___ στις οκτώ.",
      "answer": "θα έρθει",
      "accept": [
        "θα έρθει"
      ],
      "why": "Лицо меняется на 3-е (έρθει), а θα сохраняется: ότι θα έρθει.",
      "words": [
        "έρχομαι",
        "λέω"
      ],
      "tags": [
        "syntax",
        "future"
      ]
    },
    {
      "id": "b1-10-0008",
      "type": "choice",
      "prompt": "Τον ρώτησα ___ έφυγε τόσο νωρίς.",
      "options": [
        "γιατί",
        "ότι",
        "αν",
        "να"
      ],
      "answer": "γιατί",
      "why": "«Почему»: γιατί — вопросительное слово, которое сохраняется в косвенной речи.",
      "words": [
        "ρωτάω",
        "φεύγω"
      ],
      "tags": [
        "syntax",
        "questions"
      ]
    },
    {
      "id": "b1-10-0009",
      "type": "choice",
      "prompt": "Νομίζω ___ έχεις δίκιο.",
      "options": [
        "ότι",
        "αν",
        "να",
        "πού"
      ],
      "answer": "ότι",
      "why": "Утверждение в косвенной речи вводится через ότι («что»).",
      "words": [
        "νομίζω",
        "έχω"
      ],
      "tags": [
        "syntax",
        "conjunctions"
      ]
    },
    {
      "id": "b1-10-0010",
      "type": "cloze",
      "prompt": "Δεν ξέρω ___ θα έρθει. (не знаю, придёт ли он)",
      "answer": "αν",
      "accept": [
        "αν"
      ],
      "why": "«Придёт ли»: вопрос «да/нет» в косвенной речи вводится через αν.",
      "words": [
        "ξέρω",
        "έρχομαι"
      ],
      "tags": [
        "syntax",
        "conjunctions"
      ]
    },
    {
      "id": "b1-10-0011",
      "type": "choice",
      "prompt": "___ να μην αργήσω.",
      "options": [
        "Μου είπε",
        "Με είπε",
        "Μου ρώτησε",
        "Με ρώτησε"
      ],
      "answer": "Μου είπε",
      "why": "λέω требует родительного (μου) для того, кому сказали; «μου ρώτησε» и «με είπε» — ошибки.",
      "words": [
        "λέω",
        "αργώ"
      ],
      "tags": [
        "pronouns",
        "syntax"
      ]
    },
    {
      "id": "b1-10-0012",
      "type": "choice",
      "prompt": "Με ρώτησε αν ___ καφέ.",
      "options": [
        "θέλω",
        "θέλει",
        "θέλεις",
        "ήθελα"
      ],
      "answer": "θέλω",
      "why": "В косвенной речи 2-е лицо («ты хочешь?») меняется на 1-е: αν θέλω.",
      "words": [
        "θέλω",
