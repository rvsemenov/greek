{
  "rule": "A1/12-possessive-pronouns",
  "title": "Притяжательные — μου, σου, του… и δικός μου",
  "level": "A1",
  "items": [
    {
      "id": "a1-12-0001",
      "type": "choice",
      "prompt": "Ο φίλος ___ είναι εδώ. (мой друг здесь)",
      "options": [
        "μου",
        "σου",
        "του",
        "μας"
      ],
      "answer": "μου",
      "why": "Притяжательное местоимение «мой» — μου, оно не меняется по роду: ο φίλος μου.",
      "words": [
        "φίλος"
      ],
      "tags": [
        "pronouns",
        "pronouns"
      ]
    },
    {
      "id": "a1-12-0002",
      "type": "choice",
      "prompt": "Η μητέρα ___ είναι καλή. (его мать хорошая)",
      "options": [
        "του",
        "της",
        "μου",
        "σου"
      ],
      "answer": "του",
      "why": "Выбор по полу владельца: мужчина → του («его»), даже если предмет — женского рода.",
      "words": [
        "μητέρα"
      ],
      "tags": [
        "pronouns",
        "pronouns"
      ]
    },
    {
      "id": "a1-12-0003",
      "type": "choice",
      "prompt": "Ο άντρας ___ είναι γιατρός. (её муж — врач)",
      "options": [
        "της",
        "του",
        "μου",
        "σας"
      ],
      "answer": "της",
      "why": "Владелец — женщина: της («её»).",
      "words": [
        "άντρας",
        "γιατρός"
      ],
      "tags": [
        "pronouns",
        "pronouns"
      ]
    },
    {
      "id": "a1-12-0004",
      "type": "choice",
      "prompt": "Πού είναι τα κλειδιά ___ ; (где твои ключи?)",
      "options": [
        "σου",
        "μου",
        "σας",
        "του"
      ],
      "answer": "σου",
      "why": "«Твой» — σου (2-е лицо ед. ч.).",
      "words": [
        "κλειδί"
      ],
      "tags": [
        "pronouns",
        "pronouns",
        "questions"
      ]
    },
    {
      "id": "a1-12-0005",
      "type": "choice",
      "prompt": "Ο αδερφός ___ μένει στο χωριό. (мой брат живёт в деревне)",
      "options": [
        "μου",
        "σου",
        "μας",
        "τους"
      ],
      "answer": "μου",
      "why": "«Мой» — μου.",
      "words": [
        "αδερφός",
        "χωριό"
      ],
      "tags": [
        "pronouns",
        "pronouns"
      ]
    },
    {
      "id": "a1-12-0006",
      "type": "choice",
      "prompt": "Τα παιδιά αγαπάνε τους γονείς ___ . (дети любят своих родителей)",
      "options": [
        "τους",
        "του",
        "της",
        "μας"
      ],
      "answer": "τους",
      "why": "«Их» (владельцы мн. ч.): τους — и для «своих» тоже.",
      "words": [
        "παιδί",
        "γονιός"
      ],
      "tags": [
        "pronouns",
        "pronouns"
      ]
    },
    {
      "id": "a1-12-0007",
      "type": "choice",
      "prompt": "Ποιο είναι το τηλέφωνό ___ ; (какой у вас номер телефона?)",
      "options": [
        "σας",
        "μας",
        "σου",
        "τους"
      ],
      "answer": "σας",
      "why": "«Ваш» — σας (2-е лицо мн. ч. или вежливое «Вы»).",
      "words": [
        "τηλέφωνο"
      ],
      "tags": [
        "pronouns",
        "pronouns",
        "questions"
      ]
    },
    {
      "id": "a1-12-0008",
      "type": "inflect",
      "prompt": "το όνομα (имя) + μου → (моё имя, с ударением на последнем слоге)",
      "answer": "το όνομά μου",
      "accept": [
        "το όνομά μου"
      ],
      "why": "Ударение на 3-м слоге от конца → при μου появляется второе ударение: το όνομά μου.",
      "words": [
        "όνομα"
      ],
      "tags": [
        "pronouns",
        "pronouns",
        "stress"
      ]
    },
    {
      "id": "a1-12-0009",
      "type": "cloze",
      "prompt": "Αυτό είναι ___ , όχι δικό σου! (моё, а не твоё)",
      "answer": "δικό μου",
      "accept": [
        "δικό μου"
      ],
      "why": "δικός μου — «мой собственный»; средний род, ед. ч.: δικό μου.",
      "words": [
        "δικός",
        "αυτός"
      ],
      "tags": [
        "pronouns",
        "pronouns"
      ]
    },
    {
      "id": "a1-12-0010",
      "type": "choice",
      "prompt": "Έχω το ___ δωμάτιο. (у меня своя комната)",
      "options": [
        "δικό μου",
        "δική μου",
        "δικός μου",
        "δικά μου"
      ],
      "answer": "δικό μου",
      "why": "δωμάτιο — средний род, ед. ч.: δικό μου.",
      "words": [
        "δωμάτιο",
        "δικός"
      ],
      "tags": [
        "pronouns",
        "pronouns"
      ]
    },
    {
      "id": "a1-12-0011",
      "type": "choice",
      "prompt": "Το σπίτι ___ είναι μεγάλο. (наш дом большой)",
      "options": [
        "μας",
        "σας",
        "μου",
        "τους"
      ],
      "answer": "μας",
      "why": "«Наш» — μας.",
      "words": [
        "σπίτι",
        "μεγάλος"
      ],
      "tags": [
        "pronouns",
        "pronouns"
      ]
    },
    {
      "id": "a1-12-0012",
      "type": "inflect",
      "prompt": "ο φίλος μου (мой друг) → мн. ч. (мои друзья)",
      "answer": "οι φίλοι μου",
      "accept": [
        "οι φίλοι μου"
      ],
      "why": "Притяжательное μου не меняется: οι φίλοι μου.",
      "words": [
