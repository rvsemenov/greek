    {
      "id": "a1-12-0013",
      "type": "choice",
      "prompt": "Τα κλειδιά ___ είναι εκεί. (мои ключи там)",
      "options": [
        "μου",
        "σου",
        "του",
        "μας"
      ],
      "answer": "μου",
      "why": "«Мои» — μου: τα κλειδιά μου.",
      "words": [
