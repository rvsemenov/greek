{
  "rule": "A1/05-pronouns-eimai-echo",
  "title": "Личные местоимения, είμαι и έχω",
  "level": "A1",
  "items": [
    {
      "id": "a1-05-0001",
      "type": "choice",
      "prompt": "___ από τη Ρωσία.",
      "options": [
        "Είμαι",
        "Είσαι",
        "Είναι",
        "Είμαστε"
      ],
      "answer": "Είμαι",
      "why": "Для «я» (εγώ) — форма είμαι, 1 л. ед. ч. Местоимение εγώ обычно опускается.",
      "words": [
        "είμαι"
      ],
      "tags": [
        "verbs",
        "present",
        "pronouns"
      ]
    },
    {
      "id": "a1-05-0002",
      "type": "choice",
      "prompt": "Εσύ ___ εδώ;",
      "options": [
        "είμαι",
        "είσαι",
        "είναι",
        "είστε"
      ],
      "answer": "είσαι",
      "why": "Для «ты» (εσύ) — είσαι, 2 л. ед. ч. Форма είστε — вежливое «вы» или несколько человек.",
      "words": [
        "είμαι"
      ],
      "tags": [
        "verbs",
        "present",
        "pronouns"
      ]
