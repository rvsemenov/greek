{
  "rule": "A1/09-negation-questions",
  "title": "Отрицание и вопросы — δεν, όχι, вопросительные слова",
  "level": "A1",
  "items": [
    {
      "id": "a1-09-0001",
      "type": "choice",
      "prompt": "___ ξέρω.",
      "options": [
        "Δεν",
        "Όχι",
        "Ναι",
        "Μην"
      ],
      "answer": "Δεν",
      "why": "Перед глаголом «не» — δεν: Δεν ξέρω — «я не знаю». Όχι здесь не подходит.",
      "words": [
        "δεν"
      ],
      "tags": [
        "negation",
        "verbs"
      ]
    },
    {
      "id": "a1-09-0002",
      "type": "choice",
      "prompt": "— Είσαι Έλληνας; — ___, είμαι Ρώσος.",
      "options": [
        "Όχι",
        "Ναι",
        "Δεν",
        "Μην"
      ],
      "answer": "Όχι",
      "why": "«Нет» — όχι, а ναι означает «да»; ответ «нет, я русский» требует όχι.",
      "words": [
        "όχι"
      ],
      "tags": [
        "negation",
        "questions"
      ]
    },
    {
      "id": "a1-09-0003",
      "type": "cloze",
      "prompt": "___ σε λένε; (Как тебя зовут?)",
      "answer": "Πώς",
      "accept": [
        "Πώς",
        "πώς"
      ],
      "why": "«Как?» — πώς с ударением на ώ; без ударения πως — союз «что».",
      "words": [
        "πώς"
      ],
      "tags": [
        "questions"
      ]
    },
    {
      "id": "a1-09-0004",
      "type": "choice",
      "prompt": "___ μένεις;",
      "options": [
        "Πού",
        "Πότε",
        "Ποιος",
        "Πώς"
      ],
      "answer": "Πού",
      "why": "«Где?» — πού; «Πού μένεις;» — «Где ты живёшь?».",
      "words": [
        "πού",
        "μένω"
      ],
      "tags": [
        "questions",
        "verbs"
      ]
    },
    {
      "id": "a1-09-0005",
      "type": "choice",
      "prompt": "___ αρχίζει το μάθημα;",
      "options": [
        "Πότε",
        "Πού",
        "Πώς",
        "Ποιος"
      ],
      "answer": "Πότε",
      "why": "«Когда?» — πότε; вопрос о времени начала урока.",
      "words": [
        "πότε"
      ],
      "tags": [
        "questions"
      ]
    },
    {
      "id": "a1-09-0006",
      "type": "choice",
      "prompt": "___ δεν τρως;",
      "options": [
        "Γιατί",
        "Πότε",
        "Πού",
        "Πώς"
      ],
      "answer": "Γιατί",
      "why": "«Почему?» — γιατί; на вопрос «почему?» отвечают тоже γιατί: «Γιατί δεν πεινάω».",
      "words": [
        "γιατί",
        "τρώω"
      ],
      "tags": [
        "questions",
        "verbs"
      ]
    },
    {
      "id": "a1-09-0007",
      "type": "cloze",
      "prompt": "___ κάνει; (Сколько стоит?)",
      "answer": "Πόσο",
      "accept": [
        "Πόσο",
        "πόσο"
      ],
      "why": "«Πόσο κάνει;» — «Сколько стоит?»: πόσο — вопрос о количестве или цене, без изменения по роду.",
      "words": [
        "πόσος",
        "κάνω"
      ],
      "tags": [
        "questions",
        "verbs"
      ]
    },
    {
      "id": "a1-09-0008",
      "type": "choice",
      "prompt": "___ παιδιά έχεις;",
      "options": [
        "Πόσα",
        "Πόσο",
        "Πόσος",
        "Πόση"
      ],
      "answer": "Πόσα",
      "why": "πόσος согласуется с существительным: παιδιά — мн. ч. ср. р., поэтому πόσα.",
      "words": [
        "πόσος",
        "παιδί"
      ],
      "tags": [
        "questions",
        "nouns"
      ]
    },
    {
      "id": "a1-09-0009",
      "type": "choice",
      "prompt": "___ είναι το σπίτι σου;",
      "options": [
        "Ποιο",
        "Ποιος",
        "Ποια",
        "Ποιοι"
      ],
      "answer": "Ποιο",
      "why": "ποιος согласуется с родом существительного: σπίτι — ср. р., поэтому ποιο.",
      "words": [
        "ποιος",
        "σπίτι"
      ],
      "tags": [
        "questions",
        "pronouns"
      ]
    },
    {
      "id": "a1-09-0010",
      "type": "inflect",
      "prompt": "Δεν έχω ___. (χρόνος — время, винительный падеж)",
      "answer": "χρόνο",
      "accept": [
        "χρόνο"
      ],
      "why": "«У меня нет времени»: после έχω — винительный падеж, χρόνο, а не именительный χρόνος.",
      "words": [
        "χρόνος"
      ],
      "tags": [
        "negation",
        "cases",
        "accusative"
      ]
    },
    {
      "id": "a1-09-0011",
      "type": "cloze",
      "prompt": "Δεν ξέρω ___. (ничего)",
      "answer": "τίποτα",
      "accept": [
        "τίποτα"
      ],
      "why": "Слова τίποτα, ποτέ, κανένας требуют δεν при глаголе: «Δεν ξέρω τίποτα» — «я ничего не знаю».",
      "words": [
        "τίποτα",
        "ξέρω"
      ],
      "tags": [
        "negation",
        "verbs"
      ]
    },
    {
      "id": "a1-09-0012",
      "type": "choice",
      "prompt": "Δεν πίνω ___ καφέ.",
      "options": [
        "ποτέ",
        "πότε",
        "πού",
        "όχι"
      ],
      "answer": "ποτέ",
      "why": "«Я никогда не пью кофе»: ποτέ — «никогда»; πότε — вопрос «когда?», здесь не подходит.",
      "words": [
        "ποτέ",
        "πίνω"
      ],
      "tags": [
        "negation",
        "verbs"
      ]
    },
    {
      "id": "a1-09-0013",
      "type": "choice",
      "prompt": "Είσαι από τη Ρωσία, ___;",
      "options": [
        "έτσι",
        "όχι",
        "ναι",
        "τι"
      ],
      "answer": "έτσι",
      "why": "Переспрос в конце фразы — έτσι («правда?», «да?»): «Είσαι από τη Ρωσία, έτσι;»",
      "words": [
        "έτσι"
      ],
      "tags": [
        "questions"
      ]
    },
    {
      "id": "a1-09-0014",
      "type": "cloze",
      "prompt": "Δεν ___ ελληνικά. (я не говорю по-гречески)",
      "answer": "μιλάω",
      "accept": [
        "μιλάω",
        "μιλώ"
      ],
      "why": "«Я не говорю по-гречески»: отрицание δεν перед глаголом μιλάω (или μιλώ).",
      "words": [
        "μιλάω",
        "δεν"
      ],
      "tags": [
        "negation",
        "verbs"
      ]
    },
    {
      "id": "a1-09-0015",
      "type": "choice",
      "prompt": "— Θα έρθεις αύριο; — ___!",
      "options": [
        "Βέβαια",
        "Όχι",
        "Μην",
        "Δεν"
      ],
      "answer": "Βέβαια",
      "why": "«Конечно» — βέβαια; «Όχι» — отказ, «Μην» и «Δεν» на такой вопрос не отвечают.",
      "words": [
        "βέβαια",
        "αύριο"
      ],
      "tags": [
        "questions"
      ]
    },
    {
      "id": "a1-09-0016",
      "type": "inflect",
      "prompt": "Как по-гречески «не» перед глаголом?",
      "answer": "δεν",
      "accept": [
        "δεν",
        "δε"
      ],
      "why": "Перед глаголом «не» — δεν (перед некоторыми согласными допустимо δε).",
      "words": [
        "δεν"
      ],
      "tags": [
